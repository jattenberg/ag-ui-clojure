{:paths ["src" "test" "resources"]
 :min-bb-version "1.3.0"
 :tasks
 {test
  {:doc "Unit tests that run on SCI (no test.check)"
   :task (exec 'ag-ui.bb-test/run)}

  conformance
  {:doc "Fixture conformance CLI (same as clojure -M:conformance)"
   :task (apply (requiring-resolve 'ag-ui.conformance.cli/-main) *command-line-args*)}

  client
  {:doc "POST RunAgentInput to an SSE endpoint"
   :task (apply (requiring-resolve 'ag-ui.client/-main) *command-line-args*)}

  server
  {:doc "Deterministic echo SSE server (probe; JVM preferred for long runs)"
   :task (apply (requiring-resolve 'ag-ui.server/-main) *command-line-args*)}}}
